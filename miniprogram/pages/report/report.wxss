.page {
  padding-bottom: 60rpx;
}

.ph {
  color: #c2c8d2;
}

.info {
  margin-top: 16rpx;
  font-size: 15px;
  font-weight: 600;
  color: #0ca678;
}

.load-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  color: #e5484d;
  font-size: 13px;
  text-align: center;
}

.btn-retry {
  background: #12b886;
  color: #fff;
  font-size: 13px;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 40rpx;
  border-radius: 30rpx;
  margin: 0;
}

.btn-retry::after {
  border: none;
}

.section-title {
  font-size: 16px;
  font-weight: 600;
  margin: 30rpx 28rpx 4rpx;
}

.row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.badge {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #3b82f6;
  color: #fff;
  font-size: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.input.ro {
  background: #f3f5f8;
  color: #556;
  border-color: transparent;
  display: flex;
  align-items: center;
}

.subtotal-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.subtotal-label {
  font-size: 15px;
  color: #333;
}

.subtotal-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #0ca678;
}

.save-row {
  margin: 0 30rpx;
  display: flex;
  align-items: center;
}

.save-label {
  display: flex;
  align-items: center;
  font-size: 13px;
  color: #333;
}

.tip {
  text-align: center;
  color: #8a94a6;
  font-size: 11px;
  margin-top: 12rpx;
  line-height: 1.6;
}

page {
  background: #eef1f5;
  font-size: 15px;
  color: #1f2329;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.card {
  background: #fff;
  border-radius: 12rpx;
  margin: 20rpx 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(31, 35, 41, 0.04);
}

.label {
  font-size: 14px;
  color: #333;
  margin-bottom: 12rpx;
}

.label.required::before {
  content: "*";
  color: #e5484d;
  margin-right: 6rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e5e8ee;
  border-radius: 12rpx;
  background: #fff;
  box-sizing: border-box;
  font-size: 15px;
}

.input.picker {
  color: #1f2329;
}

.input.placeholder {
  color: #c2c8d2;
}

.err {
  color: #e5484d;
  font-size: 12px;
  margin-top: 8rpx;
}

.meta {
  font-size: 13px;
  color: #8a94a6;
  margin-top: 8rpx;
}

.btn-del {
  color: #e5484d;
  font-size: 13px;
  padding: 8rpx 12rpx;
}

.btn-add {
  margin: 24rpx;
  background: #fff;
  color: #3b82f6;
  border: 1rpx dashed #c9d2e3;
  border-radius: 12rpx;
  font-size: 15px;
}

.btn-add::after {
  border: none;
}

.btn-submit {
  background: #12b886;
  color: #fff;
  border-radius: 46rpx;
  font-size: 17px;
  font-weight: 600;
  margin: 30rpx 24rpx 40rpx;
}

.btn-submit::after {
  border: none;
}

.btn-submit[disabled] {
  opacity: 0.6;
  color: #fff;
  background: #12b886;
}
